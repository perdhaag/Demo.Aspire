        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Demo.Aspire.Bookings\Demo.Aspire.Bookings.csproj" />
        <ProjectReference Include="..\..\src\Demo.Aspire.Payments\Demo.Aspire.Payments.csproj" />
        <ProjectReference Include="..\..\src\Demo.Aspire.Screenings\Demo.Aspire.Screenings.csproj" />
    </ItemGroup>

</Project>
