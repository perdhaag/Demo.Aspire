{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "screenings-catalogue": {
        "ClusterId": "screenings",
        "OutputCachePolicy": "catalogue",
        "Order": 0,
        "Match": {
          "Path": "/api/screenings",
          "Methods": [ "GET" ]
        },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "screenings": {
        "ClusterId": "screenings",
        "Order": 10,
        "Match": { "Path": "/api/screenings/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "bookings": {
        "ClusterId": "bookings",
        "Match": { "Path": "/api/bookings/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "payments": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/api/notifications" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "screenings": {
        "Destinations": { "primary": { "Address": "https+http://screenings" } }
      },
      "bookings": {
        "Destinations": { "primary": { "Address": "https+http://bookings" } }
      },
      "payments": {
        "Destinations": { "primary": { "Address": "https+http://payments" } }
      },
      "notifications": {
        "Destinations": { "primary": { "Address": "https+http://notifications" } }
      }
    }
  }
}
